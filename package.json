    "build:single": "vite build --config vite.single.config.ts"
  },
  "dependencies": {
    "@astryxdesign/cli": "0.7.2",
    "@astryxdesign/core": "0.7.2",
    "@astryxdesign/theme-neutral": "0.7.2",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/onest": "5.3.1",
    "@stylexjs/stylex": "0.19.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xmldom/xmldom": "0.9.12",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=24"
  }
